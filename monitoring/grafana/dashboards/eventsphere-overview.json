{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Request Throughput (Req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{status}} - {{uri}}"
        }
      ]
    },
    {
      "title": "P95 API Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "title": "HikariCP Active Connections",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active DB Connections"
        }
      ]
    },
    {
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap Memory Used"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["eventsphere", "sre", "metrics"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "EventSphere AI - SaaS Telemetry Overview",
  "version": 1
}
